{
  "expo": {
    "name": "Immeo Gestion",
    "slug": "immeo-mobile",
    "version": "1.0.0",
    "scheme": "immeo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2B5B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.immeo.gestion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2B5B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.immeo.gestion",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accede a vos photos pour les joindre aux signalements.",
          "cameraPermission": "L'application utilise la camera pour prendre des photos de signalements."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F2B5B",
          "sounds": [],
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
